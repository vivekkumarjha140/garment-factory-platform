# Database
DB_NAME=garment_factory
DB_USER=garment_app
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
DB_PORT=3308

# Redis
REDIS_PASSWORD=CHANGE_ME

# Object storage (MinIO, local development only)
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Backend
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET
FRONTEND_BASE_URL=http://localhost:5173

# First administrator (leave empty to skip). Remove after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Razorpay (test-mode keys from the Razorpay dashboard; never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seller details printed on every tax invoice
BUSINESS_NAME=
BUSINESS_GSTIN=
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=
BUSINESS_PINCODE=
BUSINESS_STATE=
BUSINESS_STATE_CODE=
BUSINESS_EMAIL=
BUSINESS_PHONE=

# Cash on delivery
COD_ENABLED=true
COD_MAX_ORDER_AMOUNT=5000.00
COD_MAX_OPEN_ORDERS=2